---
import Layout from '../layouts/Layout.astro';
import FuturisticServiceBuilder from '../components/FuturisticServiceBuilder';

const pillars = [
  'Arquitectura visual cyber-futurista para iamanos.com',
  'Servicios modulares que se combinan por drag & drop',
  'Cotización dinámica en tiempo real con descuentos por bundle'
];
---

<Layout title="IAMANOS · Futuristic Service Lab">
  <section class="mb-10 rounded-2xl border border-cyan-300/30 bg-gradient-to-br from-slate-900 via-violet-950/60 to-slate-900 p-7 shadow-[0_0_60px_rgba(56,189,248,.18)]">
    <p class="mb-2 text-xs uppercase tracking-[0.25em] text-cyan-200/80">iamanos.com · experiencia suprema</p>
    <h1 class="mb-4 text-balance text-4xl leading-tight">Tu site futurista para vender servicios configurables</h1>
    <p class="mb-5 max-w-3xl text-lg text-white/80">
      Creamos una experiencia inmersiva: tus clientes arrastran servicios, arman su paquete ideal y obtienen
      cotización instantánea. Menos fricción, más cierres.
    </p>

    <ul class="grid gap-2 sm:grid-cols-3">
      {
        pillars.map((item) => (
          <li class="rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-sm text-white/85">{item}</li>
        ))
      }
    </ul>
  </section>



  <section class="mb-10 rounded-xl border border-emerald-300/30 bg-emerald-500/5 p-5">
    <h2 class="mb-2 text-xl font-semibold">Nueva app: Gmail → WhatsApp</h2>
    <p class="mb-3 text-white/80">Activa alertas por WhatsApp cada vez que entre un correo nuevo en Gmail.</p>
    <a class="inline-flex rounded-lg border border-emerald-300/50 px-4 py-2 text-sm text-emerald-100 hover:bg-emerald-400/10" href="/gmail-whatsapp">
      Abrir guía de implementación
    </a>
  </section>

  <FuturisticServiceBuilder client:load />
</Layout>
